ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://flightops:flightops_local_only@localhost:5432/flightops
CORS_ORIGINS=["http://localhost:5173","http://localhost:18080"]
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10

POSTGRES_DB=flightops
POSTGRES_USER=flightops
POSTGRES_PASSWORD=flightops_local_only
API_PORT=18000
FRONTEND_PORT=18080

# Frontend: leave empty when Nginx proxies /api to the API container.
VITE_API_BASE_URL=
